<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="using:Comet.Core"
        xmlns:views="using:Comet.Desktop.Views"
        x:Class="Comet.Desktop.Views.ScriptCommandsWindow"
        Title="Script Commands"
        Width="980" Height="560" MinWidth="700" MinHeight="300">

    <!-- The Windows build's ScriptCommandsForm, rewritten against what the runner actually does. -->
    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="14">
        <TextBlock Grid.Row="0" Classes="appSubtitle" TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="Functions start with ** and take tab separated arguments. Any other line is sent as typed. Every step is followed by the step delay." />

        <Grid Grid.Row="1" ColumnDefinitions="150,8,230,8,*,8,260,8,64" Margin="9,0,25,4">
            <TextBlock Grid.Column="0" Classes="fieldLabel" Text="COMMAND" />
            <TextBlock Grid.Column="2" Classes="fieldLabel" Text="ARGUMENTS" />
            <TextBlock Grid.Column="4" Classes="fieldLabel" Text="DESCRIPTION" />
            <TextBlock Grid.Column="6" Classes="fieldLabel" Text="EXAMPLE" />
        </Grid>

        <Border Grid.Row="2" Classes="well" Padding="0,4">
            <ScrollViewer>
                <ItemsControl x:Name="CommandList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="core:ScriptCommandInfo">
                            <Border BorderBrush="{DynamicResource Hairline}" BorderThickness="0,0,0,1" Padding="9,6">
                                <Grid ColumnDefinitions="150,8,230,8,*,8,260,8,64">
                                    <SelectableTextBlock Grid.Column="0" Text="{Binding Name, StringFormat='**{0}'}"
                                                         FontFamily="{DynamicResource FontMono}" FontSize="11"
                                                         Foreground="{DynamicResource Accent}" />
                                    <SelectableTextBlock Grid.Column="2" Text="{Binding ArgumentText}" FontSize="11"
                                                         TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" />
                                    <SelectableTextBlock Grid.Column="4" Text="{Binding Description}" FontSize="11"
                                                         TextWrapping="Wrap" Foreground="{DynamicResource TextPrimary}" />
                                    <SelectableTextBlock Grid.Column="6" Text="{Binding Example}" FontSize="10.5"
                                                         TextWrapping="Wrap" FontFamily="{DynamicResource FontMono}"
                                                         Foreground="{DynamicResource TextSecondary}" />
                                    <Button Grid.Column="8" Content="INSERT" VerticalAlignment="Top"
                                            IsVisible="{Binding $parent[views:ScriptCommandsWindow].CanInsert}"
                                            Click="OnInsert" Tag="{Binding}"
                                            ToolTip.Tip="Add this function to the script being edited" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="3" ColumnDefinitions="*,Auto,6,Auto" Margin="0,10,0,0">
            <Button Grid.Column="1" Content="COPY TABLE" Click="OnCopy" />
            <Button Grid.Column="3" Classes="primary" Content="CLOSE" Width="80" Click="OnClose" IsCancel="True" />
        </Grid>
    </Grid>
</Window>
