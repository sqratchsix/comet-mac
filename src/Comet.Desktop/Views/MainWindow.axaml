<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Comet.Desktop.ViewModels"
        xmlns:core="using:Comet.Core"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1060" d:DesignHeight="680"
        x:Class="Comet.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/comet.ico"
        Title="{Binding Title}"
        Width="1060" Height="680"
        MinWidth="880" MinHeight="660">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <!-- Right-click anywhere outside the terminal and history panes. -->
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="New Window" Click="OnNewWindowItem" />
            <MenuItem Header="Open Containing Folder" Command="{Binding OpenContainingFolderCommand}" />
            <Separator />
            <MenuItem Header="New Script…" Click="OnNewScriptItem" />
            <MenuItem Header="Stop Script" Command="{Binding StopScriptCommand}" />
            <MenuItem Header="Script Commands…" Click="OnScriptCommandsItem" />
            <MenuItem Header="Open Response Log" Command="{Binding OpenResponseLogCommand}" />
            <Separator />
            <MenuItem Header="Refresh Ports" Command="{Binding RefreshPortsCommand}" />
            <MenuItem Header="{Binding OpenCloseMenuLabel}" Command="{Binding TogglePortCommand}" />
        </ContextMenu>
    </Window.ContextMenu>

    <NativeMenu.Menu>
        <NativeMenu>
            <NativeMenuItem Header="File">
                <NativeMenuItem.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="New Window" Gesture="Cmd+N" Click="OnNewWindow" />
                        <NativeMenuItem Header="Close Window" Gesture="Cmd+W" Click="OnCloseWindow" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Open History…" Gesture="Cmd+O" Click="OnOpenHistory" />
                        <NativeMenuItem Header="Append History…" Click="OnAppendHistory" />
                        <NativeMenuItem Header="Save History As…" Gesture="Cmd+S" Click="OnSaveHistory" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Reveal History File in Finder" Click="OnRevealHistoryFile" />
                        <NativeMenuItem Header="Open Containing Folder" Command="{Binding OpenContainingFolderCommand}" />
                    </NativeMenu>
                </NativeMenuItem.Menu>
            </NativeMenuItem>
            <NativeMenuItem Header="Terminal">
                <NativeMenuItem.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="Clear Terminal" Gesture="Cmd+K" Command="{Binding ClearTerminalCommand}" />
                        <NativeMenuItem Header="Send Break" Command="{Binding SendBreakCommand}" />
                        <NativeMenuItem Header="Reset Buffer" Command="{Binding ResetBufferCommand}" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Refresh Ports" Gesture="Cmd+R" Command="{Binding RefreshPortsCommand}" />
                        <NativeMenuItem Header="Open / Close Port" Gesture="Cmd+T" Command="{Binding TogglePortCommand}" />
                    </NativeMenu>
                </NativeMenuItem.Menu>
            </NativeMenuItem>
            <NativeMenuItem Header="Script">
                <NativeMenuItem.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="New Script…" Click="OnNewScript" />
                        <NativeMenuItem Header="Stop Script" Gesture="Cmd+OemPeriod" Command="{Binding StopScriptCommand}" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Script Commands…" Click="OnScriptCommands" />
                        <NativeMenuItem Header="Open Response Log" Command="{Binding OpenResponseLogCommand}" />
                    </NativeMenu>
                </NativeMenuItem.Menu>
            </NativeMenuItem>
            <NativeMenuItem Header="History">
                <NativeMenuItem.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="Toggle CMD / Description" Command="{Binding ToggleButtonLabelsCommand}" />
                        <NativeMenuItem Header="Remove All Buttons" Command="{Binding ClearHistoryCommand}" />
                    </NativeMenu>
                </NativeMenuItem.Menu>
            </NativeMenuItem>
        </NativeMenu>
    </NativeMenu.Menu>

    <!-- Outer padding 14, section spacing 12, matching mmyyxx's ContentView. -->
    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="14">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <TextBlock Grid.Column="0" Classes="appTitle" Text="COMET" VerticalAlignment="Center" />

            <!-- A B C D: load ButtonA.txt..ButtonD.txt from COMET's folder, as on Windows. -->
            <ItemsControl Grid.Column="1" ItemsSource="{Binding QuickLoadSlots}" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:QuickLoadSlot">
                        <Button Classes="quickLoad"
                                Classes.loaded="{Binding IsLoaded}"
                                Classes.missing="{Binding !Exists}"
                                Content="{Binding Letter}"
                                ToolTip.Tip="{Binding Tooltip}"
                                Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).LoadQuickSlotCommand}"
                                CommandParameter="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </Grid>

        <!-- Connection bar -->
        <Border Grid.Row="1" Classes="well" Padding="11,8" Margin="0,0,0,12">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Ellipse Grid.Column="0" Width="7" Height="7" Margin="0,0,8,0" VerticalAlignment="Center"
                         Fill="{Binding IsPortOpen, Converter={x:Static vm:StatusBrushes.Converter}}" />
                <TextBlock Grid.Column="1" Classes="barText" VerticalAlignment="Center"
                           Text="{Binding ConnectionSummary}" TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="2" Classes="link" Content="Refresh ports"
                        Command="{Binding RefreshPortsCommand}" />
            </Grid>
        </Border>

        <!--
            The three columns share one row grid rather than nesting their own,
            so the action row at the foot lines up exactly across them: OPEN PORT
            sits on the same baseline as the command bar beside it.
        -->
        <Grid Grid.Row="2" RowDefinitions="Auto,*,Auto" ColumnDefinitions="176,14,*,14,240">

            <!-- Column headings -->
            <TextBlock Grid.Row="0" Grid.Column="0" Classes="section" Text="PORT" Margin="2,0,0,6" />

            <Grid Grid.Row="0" Grid.Column="2" ColumnDefinitions="Auto,*,Auto" Margin="2,0,0,6">
                <TextBlock Grid.Column="0" Classes="section" Text="TERMINAL" VerticalAlignment="Center" />
                <Button Grid.Column="2" Content="CLEAR" Command="{Binding ClearTerminalCommand}" />
            </Grid>

            <Grid Grid.Row="0" Grid.Column="4" ColumnDefinitions="Auto,*,Auto,4,Auto,4,Auto" Margin="2,0,0,6">
                <TextBlock Grid.Column="0" Classes="section" Text="HISTORY" VerticalAlignment="Center" />
                <Button Grid.Column="2" Content="LABELS" Command="{Binding ToggleButtonLabelsCommand}"
                        ToolTip.Tip="Swap between the command and its description" />
                <Button Grid.Column="4" Content="CLEAR" Command="{Binding ClearHistoryCommand}" />
                <ToggleButton Grid.Column="6" Classes="chip view compact" Content="REC"
                              IsChecked="{Binding RecordHistory, Mode=TwoWay}"
                              ToolTip.Tip="Add each sent command to this pane" />
            </Grid>

            <!-- Port settings -->
            <!--
                Never scrolls: the window's MinHeight is set so every setting fits.
                Adding a control here means re-measuring that, see CLAUDE.md.
            -->
            <Border x:Name="PortPanel" Grid.Row="1" Grid.Column="0" Classes="panel" Padding="8,10">
                    <StackPanel x:Name="PortSettings" Spacing="7" VerticalAlignment="Top">

                        <StackPanel>
                            <TextBlock Classes="fieldLabel" Text="DEVICE" />
                            <!-- Live while the port is open: opening it closes the port, picking reopens. -->
                            <ComboBox ItemsSource="{Binding Ports}"
                                      SelectedItem="{Binding SelectedPort}"
                                      DropDownOpened="OnDeviceDropDownOpened"
                                      DropDownClosed="OnDeviceDropDownClosed"
                                      ToolTip.Tip="{Binding SelectedPort.DeviceName}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="core:SerialPortInfo">
                                        <TextBlock Text="{Binding ShortName}" FontSize="11"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Classes="fieldLabel" Text="BAUD" />
                            <AutoCompleteBox ItemsSource="{Binding BaudRates}"
                                             Text="{Binding SelectedBaudRate, Mode=TwoWay}"
                                             IsEnabled="{Binding CanEditLineSettings}"
                                             FilterMode="StartsWith"
                                             MinimumPrefixLength="0"
                                             ToolTip.Tip="Pick a standard rate or type any value" />
                        </StackPanel>

                        <Grid ColumnDefinitions="*,6,*">
                            <StackPanel Grid.Column="0">
                                <TextBlock Classes="fieldLabel" Text="DATA" />
                                <ComboBox ItemsSource="{Binding DataBitsOptions}"
                                          SelectedItem="{Binding SelectedDataBits}"
                                          IsEnabled="{Binding CanEditLineSettings}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Classes="fieldLabel" Text="STOP" />
                                <ComboBox ItemsSource="{Binding StopBitsOptions}"
                                          SelectedItem="{Binding SelectedStopBits}"
                                          IsEnabled="{Binding CanEditLineSettings}" />
                            </StackPanel>
                        </Grid>

                        <StackPanel>
                            <TextBlock Classes="fieldLabel" Text="PARITY" />
                            <ComboBox ItemsSource="{Binding ParityOptions}"
                                      SelectedItem="{Binding SelectedParity}"
                                      IsEnabled="{Binding CanEditLineSettings}" />
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Classes="fieldLabel" Text="FORMAT" />
                            <Grid ColumnDefinitions="*,3,*">
                                <ToggleButton Grid.Column="0" Classes="chip" Content="ASCII"
                                              IsChecked="{Binding IsAsciiMode, Mode=TwoWay}" />
                                <ToggleButton Grid.Column="2" Classes="chip" Content="HEX"
                                              IsChecked="{Binding IsHexMode, Mode=TwoWay}" />
                            </Grid>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Classes="fieldLabel" Text="WRITE ENDING" />
                            <Grid ColumnDefinitions="*,3,*">
                                <ToggleButton Grid.Column="0" Classes="chip" Content="CR"
                                              IsChecked="{Binding WriteCr, Mode=TwoWay}" />
                                <ToggleButton Grid.Column="2" Classes="chip" Content="NL"
                                              IsChecked="{Binding WriteNl, Mode=TwoWay}" />
                            </Grid>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Classes="fieldLabel" Text="CONTROL LINES" />
                            <Grid ColumnDefinitions="*,3,*,3,*" IsEnabled="{Binding HasSerialLine}">
                                <ToggleButton Grid.Column="0" Classes="chip line" Content="DTR"
                                              IsChecked="{Binding DtrEnabled, Mode=TwoWay}" />
                                <ToggleButton Grid.Column="2" Classes="chip line" Content="RTS"
                                              IsChecked="{Binding RtsEnabled, Mode=TwoWay}" />
                                <Button Grid.Column="4" Content="BRK"
                                        Command="{Binding SendBreakCommand}"
                                        ToolTip.Tip="Send break" />
                            </Grid>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Classes="fieldLabel" Text="DISPLAY" />
                            <Grid ColumnDefinitions="*,3,*">
                                <ToggleButton Grid.Column="0" Classes="chip view" Content="CR/NL"
                                              IsChecked="{Binding AddNewLineToTerminal, Mode=TwoWay}"
                                              ToolTip.Tip="Put each received message on its own line" />
                                <ToggleButton Grid.Column="2" Classes="chip view" Content="SPACES"
                                              IsChecked="{Binding ByteSpaces, Mode=TwoWay}"
                                              ToolTip.Tip="Space between bytes in HEX mode" />
                            </Grid>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Classes="fieldLabel" Text="TIMESTAMP" />
                            <Grid ColumnDefinitions="46,4,*">
                                <ToggleButton Grid.Column="0" Classes="chip view" Content="ON"
                                              IsChecked="{Binding TimestampEnabled, Mode=TwoWay}"
                                              ToolTip.Tip="Prefix each line with the time" />
                                <TextBox Grid.Column="2" Classes="readout" Text="{Binding TimestampFormat}"
                                         IsEnabled="{Binding TimestampEnabled}" />
                            </Grid>
                        </StackPanel>

                        <Grid ColumnDefinitions="*,6,*">
                            <StackPanel Grid.Column="0">
                                <TextBlock Classes="fieldLabel" Text="WRITE MS" />
                                <TextBox Classes="readout" Text="{Binding TimeoutText}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Classes="fieldLabel" Text="IDLE MS" />
                                <TextBox Classes="readout" Text="{Binding ReadTimeoutText}" />
                            </StackPanel>
                        </Grid>

                    </StackPanel>
            </Border>

            <!-- The port's action, on the command bar's baseline. -->
            <Button Grid.Row="2" Grid.Column="0" Classes="primary"
                    Classes.live="{Binding IsPortOpen}"
                    Content="{Binding OpenCloseLabel}"
                    Command="{Binding TogglePortCommand}"
                    VerticalAlignment="Stretch"
                    Margin="0,8,0,0" />

            <!-- Terminal -->
            <Border Grid.Row="1" Grid.Column="2" Classes="well" ClipToBounds="True">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Copy" Click="OnTerminalCopy" />
                        <MenuItem Header="Select All" Click="OnTerminalSelectAll" />
                        <MenuItem Header="Clear Terminal" Command="{Binding ClearTerminalCommand}" />
                        <Separator />
                        <MenuItem Header="{Binding TimestampMenuLabel}" Command="{Binding ToggleTimestampsCommand}" />
                        <MenuItem Header="Timestamp Format" ItemsSource="{Binding TimestampFormats}">
                            <MenuItem.Styles>
                                <Style Selector="MenuItem > MenuItem" x:DataType="x:String">
                                    <Setter Property="Header" Value="{Binding}" />
                                    <Setter Property="Command"
                                            Value="{Binding $parent[ContextMenu].((vm:MainViewModel)DataContext).SetTimestampFormatCommand}" />
                                    <Setter Property="CommandParameter" Value="{Binding}" />
                                </Style>
                            </MenuItem.Styles>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Send Break" Command="{Binding SendBreakCommand}" />
                        <MenuItem Header="Reset Buffer" Command="{Binding ResetBufferCommand}" />
                        <Separator />
                        <MenuItem Header="New Window" Click="OnNewWindowItem" />
                        <MenuItem Header="Open Containing Folder" Command="{Binding OpenContainingFolderCommand}" />
                    </ContextMenu>
                </Border.ContextMenu>
                <ScrollViewer x:Name="TerminalScroll" Padding="10,8">
                    <SelectableTextBlock x:Name="Terminal"
                                         ContextFlyout="{x:Null}"
                                         FontFamily="{DynamicResource FontMono}"
                                         FontSize="11.5"
                                         TextWrapping="Wrap"
                                         Foreground="{DynamicResource TerminalReceive}"
                                         SelectionBrush="#2A5C6E" />
                </ScrollViewer>
            </Border>

            <Grid Grid.Row="2" Grid.Column="2" ColumnDefinitions="*,6,Auto" Margin="0,8,0,0">
                <TextBox x:Name="InputBox" Grid.Column="0" Classes="command"
                         Text="{Binding InputText}"
                         PlaceholderText="Type a command, press Return to send"
                         KeyDown="OnInputKeyDown" />
                <Button Grid.Column="2" Classes="primary" Content="SEND" Width="66"
                        Command="{Binding SendCommand}" VerticalAlignment="Stretch" />
            </Grid>

            <!-- History, running the full height beside both rows. -->
            <Border x:Name="HistoryPanel" Grid.Row="1" Grid.RowSpan="2" Grid.Column="4" Classes="panel" Padding="7,8">
                <!--
                    One menu for the pane and its buttons, as on Windows. Right-clicking
                    a button shows that button's actions above the pane's; the code
                    behind records which button was clicked and fills Load Commands.
                -->
                <Border.ContextMenu>
                    <ContextMenu x:Name="HistoryMenu" Opening="OnHistoryMenuOpening">
                        <MenuItem x:Name="SendButtonItem" Click="OnSendClickedButton" />
                        <MenuItem x:Name="EditScriptItem" Header="Edit Script…" Click="OnEditClickedScript" />
                        <MenuItem x:Name="CopyButtonItem" Header="Copy Command" Click="OnCopyClickedButton" />
                        <MenuItem x:Name="EditButtonItem" Header="Copy to Input" Click="OnEditClickedButton" />
                        <MenuItem x:Name="RemoveButtonItem" Header="Remove Button" Click="OnRemoveClickedButton" />
                        <Separator x:Name="ButtonItemsSeparator" />
                        <MenuItem Header="New Script…" Click="OnNewScriptItem" />
                        <MenuItem Header="Stop Script" Command="{Binding StopScriptCommand}"
                                  IsVisible="{Binding IsScriptRunning}" />
                        <MenuItem Header="Script Commands…" Click="OnScriptCommandsItem" />
                        <Separator />
                        <MenuItem x:Name="LoadCommandsItem" Header="Load Commands" />
                        <MenuItem Header="Append Commands…" Click="OnAppendHistoryItem" />
                        <MenuItem Header="Save Commands As…" Click="OnSaveHistoryItem" />
                        <Separator />
                        <MenuItem Header="Toggle CMD / Description" Command="{Binding ToggleButtonLabelsCommand}" />
                        <MenuItem Header="Remove All Buttons" Command="{Binding ClearHistoryCommand}" />
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <!-- Shown until the pane has something in it. -->
                    <TextBlock Classes="appSubtitle"
                               Text="Commands you send appear here.&#10;Drop a .txt command file to load a set."
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="10"
                               IsVisible="{Binding !History.Count}" />

                    <!--
                        Buttons build upward from the foot of the pane, as on Windows:
                        the first entry sits at the bottom and each new one lands on
                        top, so a loaded file reads bottom to top.
                    -->
                    <ScrollViewer x:Name="HistoryScroll">
                        <ItemsControl ItemsSource="{Binding History}" VerticalAlignment="Bottom">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ReversibleStackPanel ReverseOrder="True" Spacing="3" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="core:CommandEntry">
                                    <Button Classes="history"
                                            Classes.alt="{Binding IsAlternateStyle}"
                                            Classes.script="{Binding IsScript}"
                                            Content="{Binding DisplayText}"
                                            ToolTip.Tip="{Binding TooltipText}"
                                            Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SendEntryCommand}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer: connection facts on the left, the latest status message on the right. -->
        <Grid Grid.Row="3" ColumnDefinitions="Auto,16,Auto,16,*" Margin="0,12,0,0">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
            <Border Classes="statusChip"
                    Background="{Binding IsPortOpen, Converter={x:Static vm:StatusBrushes.ChipBackground}}">
                <TextBlock Text="{Binding IsPortOpen, Converter={x:Static vm:StatusBrushes.ChipLabel}}"
                           Foreground="{Binding IsPortOpen, Converter={x:Static vm:StatusBrushes.Converter}}" />
            </Border>
            <TextBlock Classes="footer" Text="{Binding LineSettingSummary}" />
            <TextBlock Classes="footer" Text="·" />
            <TextBlock Classes="footer" Text="{Binding FormatSummary}" />
            <TextBlock Classes="footer" Text="·" />
            <TextBlock Classes="footer" Text="{Binding HistorySummary}" />
            <TextBlock Classes="footer" Text="·"
                       IsVisible="{Binding CurrentHistoryFileName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <TextBlock Classes="footer" Text="{Binding CurrentHistoryFileName}" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsScriptRunning}">
            <TextBlock Classes="footer running" Text="{Binding ScriptProgressText}" />
            <Button Content="STOP" Padding="8,2" Command="{Binding StopScriptCommand}"
                    ToolTip.Tip="Stop the running script (⌘.)" />
        </StackPanel>
        <TextBlock Grid.Column="4" Classes="footer status"
                   Classes.error="{Binding StatusIsError}"
                   Text="{Binding StatusMessage}"
                   ToolTip.Tip="{Binding StatusMessage}"
                   HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
        </Grid>
    </Grid>
</Window>
