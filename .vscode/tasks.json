{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": ["build", "${workspaceFolder}/Comet.slnx"],
            "problemMatcher": "$msCompile",
            "group": { "kind": "build", "isDefault": true }
        },
        {
            "label": "test",
            "command": "dotnet",
            "type": "process",
            "args": ["test", "${workspaceFolder}/Comet.slnx"],
            "problemMatcher": "$msCompile",
            "group": { "kind": "test", "isDefault": true }
        },
        {
            "label": "build app bundle",
            "command": "${workspaceFolder}/scripts/build-app.sh",
            "type": "process",
            "problemMatcher": []
        }
    ]
}
